rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Material requests: a weigher opens one, a puller on a different phone delivers it.
    // Times are always stamped by the server, so a phone's clock cannot change a wait time.
    match /requests/{id} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['name', 'lot', 'batchName', 'item', 'status', 'uid', 'clientAt', 'requestedAt'])
        && request.resource.data.status == 'open'
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.requestedAt == request.time
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() < 60;

      allow update: if request.auth != null
        && resource.data.status == 'open'
        && (
          // delivered: not by the phone that asked
          ( request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'deliveredAt', 'deliveredBy'])
            && request.resource.data.status == 'delivered'
            && request.resource.data.deliveredAt == request.time
            && request.resource.data.deliveredBy is string
            && request.resource.data.deliveredBy.size() > 0
            && resource.data.uid != request.auth.uid )
          ||
          // cancelled: only by the phone that asked, and the record is kept
          ( request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && request.resource.data.status == 'cancelled'
            && resource.data.uid == request.auth.uid )
        );

      allow delete: if false;
    }

    // Puller PIN: one document with a field called pin. Edited by hand in the Firebase console only.
    match /config/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
